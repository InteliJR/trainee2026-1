{
  "name": "@ecorota/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:format": "prisma format",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "database:verify": "tsx scripts/verify-database.ts",
    "database:seed:development": "tsx scripts/seed-development.ts",
    "flow:verify": "tsx scripts/verify-first-flow.ts",
    "sync:verify": "tsx scripts/verify-domain-sync.ts"
  },
  "dependencies": {
    "@ecorota/shared": "workspace:^",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "pg": "^8.23.0",
    "socket.io": "^4.8.3",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^22.5.4",
    "@types/pg": "^8.23.1",
    "@types/socket.io": "^3.0.2",
    "@types/ws": "^8.18.1",
    "prisma": "7.10.0",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4",
    "vitest": "^2.1.1"
  }
}
