# =========================================================
# Template de ambiente — copie para .env e preencha os valores.
# NUNCA commitar o .env de verdade.
# Documentação: https://ecorota.marcusvalente.dev.br/docs/
# =========================================================

# URL base da API EcoRota (sem barra final)
ECOROTA_URL=https://ecorota.marcusvalente.dev.br

# Credencial Bearer do ambiente da equipe (vive SOMENTE no backend)
ECOROTA_KEY=coloque_a_credencial_aqui

# Porta do serviço próprio
PORT=3000

# PostgreSQL Supabase usado pela aplicação em tempo de execução.
# Em ambiente persistente, pode ser a conexão direta ou o session pooler.
DATABASE_URL=postgresql://usuario:senha@host:5432/postgres?sslmode=require

# Conexão direta usada pelo Prisma CLI para migrations.
# Obtenha no painel do Supabase em Connect > Direct connection.
DIRECT_URL=postgresql://usuario:senha@db.projeto.supabase.co:5432/postgres?sslmode=require

# Segredo para assinar os JWT da nossa autenticação
JWT_SECRET=
